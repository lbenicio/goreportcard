# Relational database URL. The database must exist before the app starts.
DATABASE_URL=postgresql://user:password@localhost:5432/goreportcard?sslmode=disable

# Optional Redis URL for shared analysis jobs and cache.
# REDIS_URL=redis://localhost:6379/0

# Web server listen address.
HTTP_ADDR=:8000

# Minimum log level: debug, info, warn, or error.
LOG_LEVEL=info

# Log colors: auto, always, or never. NO_COLOR disables auto coloring.
LOG_COLOR=auto
